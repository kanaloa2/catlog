{
  // CatLog on Cloudflare Workers: serves the built app, plus /api/add and /api/log for shortcuts
  // and an email() handler for Email Routing (see worker/index.ts).
  // `wrangler deploy` runs the build first, so Workers Builds needs no separate build command.
  "name": "catlog",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://hpyjxwmfxjopbvojagqe.supabase.co",
    "SUPABASE_KEY": "sb_publishable_KdcUeJFeSRmSzNPe7pijWQ_bt3z9eGP"
  }
}
